{
  "extends": "../../tsconfig.base.json",
  // allowImportingTsExtensions: test/generated/index.ts (contracts codegen) re-exports with `.ts`
  // specifiers so the examples can import it under plain Node; noEmit here, the library build
  // (vp pack) only reads src/.
  "compilerOptions": { "noEmit": true, "allowImportingTsExtensions": true },
  "include": ["src", "test"]
}
