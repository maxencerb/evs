// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`runtime bytecode is byte-stable > arithmetic + select + literals (no calls) 1`] = `""`;

exports[`runtime bytecode is byte-stable > array construction + loop-free mutation 1`] = `""`;

exports[`runtime bytecode is byte-stable > mutable verbs: call / tryCall / simulate / trySimulate 1`] = `""`;

exports[`runtime bytecode is byte-stable > paris target (pre-PUSH0 / @memcpy fork) 1`] = `""`;

exports[`runtime bytecode is byte-stable > reads: string output, arg + gas cap, tuple-index output, tryRead + select 1`] = `""`;

exports[`runtime bytecode is byte-stable > struct: true read + tryRead (tuple output through the memory decoders) 1`] = `""`;
