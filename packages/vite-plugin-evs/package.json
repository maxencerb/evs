{
  "name": "@maxencerb/vite-plugin-evs",
  "version": "0.0.0",
  "description": "Vite plugin for @maxencerb/evs: compiles *.evs.ts scripts at build time, so the client bundle ships the bytecode and not the compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxencerb/evs.git",
    "directory": "packages/vite-plugin-evs"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "bench": "node scripts/bench.ts",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --project plugin",
    "test:integration": "vp test run --project plugin-integration",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@maxencerb/evs": "workspace:*",
    "prool": "catalog:testing",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@maxencerb/evs": "workspace:^",
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
