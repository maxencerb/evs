---
// Top bar. The wordmark sits over the sidebar column, the search field starts at the content
// panel's left edge, and the right side carries the section links, the social links and the
// published package version. Pages without a sidebar (the landing page) have no sidebar footer,
// so the theme switch moves up here.
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import pkg from '@maxencerb/evs/package.json';

import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';

const { hasSidebar } = Astro.locals.starlightRoute;

// `prefix` decides which link is marked current; `href` is the section's first page.
const sections = [
  { label: 'Guides', href: '/guides/writing-scripts/', prefix: '/guides/' },
  { label: 'Reference', href: '/reference/builder/', prefix: '/reference/' },
  { label: 'Examples', href: '/examples/pool-metadata/', prefix: '/examples/' },
];
const path = Astro.url.pathname;
const changelog = 'https://github.com/maxencerb/evs/blob/main/packages/evs/CHANGELOG.md';
---

<div class="bar">
  <div class="brand">
    <SiteTitle />
  </div>
  <div class="search print:hidden">
    <Search />
  </div>
  <nav class="sections print:hidden" aria-label="Sections">
    {
      sections.map(({ label, href, prefix }) => (
        <a {href} aria-current={path.startsWith(prefix) ? 'true' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <div class="meta print:hidden">
    <div class="social">
      <SocialIcons />
    </div>
    <a class="version" href={changelog} title="Changelog">v{pkg.version}</a>
    {!hasSidebar && <ThemeSelect />}
  </div>
</div>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }

  .brand {
    flex: none;
    margin-inline-end: auto;
  }

  .search {
    display: flex;
  }

  .sections,
  .social,
  .version {
    display: none;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .bar {
      gap: 0;
    }

    .brand {
      margin-inline-end: 1.5rem;
    }

    /* The wordmark column spans the sidebar, which puts the search field on the panel's edge. */
    :global([data-has-sidebar]) .brand {
      width: calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x) + 1px);
      margin-inline-end: 0;
    }

    /* Shrinks before anything else does: on a narrow desktop the links keep their room. */
    .search {
      flex: 0 1 15rem;
      min-width: 0;
      margin-inline-end: auto;
    }

    .sections {
      display: flex;
      align-self: stretch;
      gap: 0.25rem;
      margin-inline: 1rem;
    }

    .sections a {
      display: flex;
      align-items: center;
      padding-inline: 0.5rem;
      color: var(--evs-text-2);
      font-size: 0.875rem;
      font-weight: 450;
      text-decoration: none;
      /* The marker is drawn inside the link so it lands on the bar's bottom edge. */
      box-shadow: inset 0 -2px 0 transparent;
      transition:
        color 120ms ease,
        box-shadow 120ms ease;
    }

    .sections a:hover {
      color: var(--evs-heading);
    }

    .sections a[aria-current='true'] {
      color: var(--evs-heading);
      box-shadow: inset 0 -2px 0 var(--evs-accent);
    }

    .sections a:focus-visible {
      outline-offset: -2px;
    }

    .version {
      border-radius: var(--evs-radius-sm);
      color: var(--evs-text-2);
      font-size: 0.8125rem;
      font-weight: 450;
      font-variant-numeric: tabular-nums;
      text-decoration: none;
    }

    .version:hover {
      color: var(--evs-heading);
    }
  }

  /* Beside a sidebar the bar is tight: the version joins at 56rem and the icons (which also
     sit in the sidebar footer) at 64rem. Without a sidebar there is room for both throughout. */
  @media (min-width: 56rem) {
    .version {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .social {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  :global(html:not([data-has-sidebar])) .social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    :global(html:not([data-has-sidebar])) .version {
      display: block;
    }
  }

  .social :global(a) {
    margin: -0.375rem;
    border-radius: var(--evs-radius-md);
    padding: 0.375rem;
    color: var(--evs-text-2);
    font-size: 1.125rem;
  }

  .social :global(a:hover) {
    color: var(--evs-heading);
  }
</style>
