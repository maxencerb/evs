---
// Landing-page hero: Starlight's default `Hero` (title / tagline / actions from the page
// frontmatter) laid over the same animated dune ridges as the repository banner
// (`.github/assets/evs-banner.svg`). The ridges are drawn with `currentColor` so the same
// paths work in both colour schemes: light strokes on a near-black ground in dark mode,
// dark strokes on a near-white ground in light mode. Registered via `components.Hero` in
// `astro.config.mjs`; every other page keeps Starlight's built-in hero.
//
// Extras over the stock hero, all landing-page specific: a facts strip, actions split into a
// primary row and a minimal row, an install line with a package-manager switcher and a copy
// button, and a "copy prompt" button that hands an AI coding agent the gist of the library plus
// the /llms.txt endpoints.
//
// The ridges carry no SVG filter, deliberately, and this is the one place that matters: the
// banner is an `<img>`, which WebKit rasterises as its own image document into a single
// composited layer, so its `feGaussianBlur` costs nothing per frame. Inline in this page the
// ridges are ordinary SVG sub-elements, which WebKit does not composite — the `transform` on
// each animated `<g>` re-maps its filtered children every frame and the blur is re-run on the
// CPU, over path extents (x -200..2400, y -200..900) that made it millions of pixels per frame.
// Safari crawled; Chromium and Firefox layerise the group and never noticed.
//
// Two filter-free equivalents replace it:
//   - each crest glow is a stack of concentric strokes over one `<use>`d path. The ring radii sit
//     at equal steps of the blurred profile's own alpha, with two fainter rings out in the tail,
//     so the composite traces the Gaussian to within ~0.013 alpha with no step above ~6/255 and
//     an outermost edge at ~1.6/255. A plain two-stroke approximation banded visibly.
//   - the `hero-shadow` band's soft top edge is baked into its gradient stops, which sample the
//     error function the stdDeviation="10" blur produced across the path's bounding box.
import { LinkButton } from '@astrojs/starlight/components';

const { data, id } = Astro.locals.starlightRoute.entry;
// The 404 page (src/pages/404.astro) also renders through this component (it has a hero); the
// install line and the facts strip are for the landing page only.
const isLanding = id !== '404';
const { title = data.title, tagline, actions = [] } = data.hero || {};
const primaryActions = actions.filter((a) => a.variant !== 'minimal');
const minimalActions = actions.filter((a) => a.variant === 'minimal');

// Same value as Starlight's `PAGE_TITLE_ID` (`_top`): the skip-link / ToC target.
const PAGE_TITLE_ID = '_top';

const facts = [
  { term: 'One eth_call', detail: 'Dependent reads run inside a single RPC round trip.' },
  { term: 'Typed through viem', detail: 'The script is its own ABI; readContract infers args and result.' },
  { term: 'Nothing to deploy', detail: 'Deployless by default, state override when msg.sender matters.' },
  { term: 'solc 0.8 semantics', detail: 'Checked arithmetic, verbatim revert bubbling, panic codes.' },
];

const managers = [
  { id: 'bun', label: 'bun', command: 'bun add @maxencerb/evs viem' },
  { id: 'npm', label: 'npm', command: 'npm install @maxencerb/evs viem' },
  { id: 'pnpm', label: 'pnpm', command: 'pnpm add @maxencerb/evs viem' },
  { id: 'yarn', label: 'yarn', command: 'yarn add @maxencerb/evs viem' },
  { id: 'deno', label: 'deno', command: 'deno add npm:@maxencerb/evs npm:viem' },
];

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://evs.maxencerb.com';
const agentPrompt = `I want to use @maxencerb/evs ("evs") in this project.

evs is a TypeScript library for typed, read-only EVM scripts. You write a callback against a small builder API (s.read / s.call / s.simulate for calls, s.if / s.for / s.select for runtime control flow, checked arithmetic), it compiles to EVM runtime bytecode, and viem executes it as one deployless eth_call. Reads whose target depends on an earlier read (pool.token0() then token0.symbol()) batch into a single round trip, which a multicall cannot do, and the script's literal ABI gives readContract full argument and result inference.

Install: ${managers[0]?.command} (peer viem >= 2.14.1, ESM only, TypeScript >= 5.5 in strict mode).

Read the documentation before writing code:
- Index: ${site}/llms.txt
- Full text: ${site}/llms-full.txt

Rules that matter: the builder callback runs once at build time and records statements, so native JS if/for only unroll host values and never branch on chain data; use the s.* combinators for runtime values. Execute with client.readContract({ ...compiled.toViem(), functionName, args }); pass toViem({ mode: 'stateOverride' }) plus an account when the script reads msg.sender.
`;
---

<section class="hero">
  <svg
    class="waves"
    viewBox="0 0 2176 714"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="hero-ridge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.55" />
        <stop offset="0.08" stop-color="currentColor" stop-opacity="0.22" />
        <stop offset="0.4" stop-color="currentColor" stop-opacity="0.06" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="hero-ridge-soft" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.26" />
        <stop offset="0.2" stop-color="currentColor" stop-opacity="0.08" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="hero-shadow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.0" stop-color="var(--hero-ground)" stop-opacity="0.019" />
        <stop offset="0.0085" stop-color="var(--hero-ground)" stop-opacity="0.057" />
        <stop offset="0.0169" stop-color="var(--hero-ground)" stop-opacity="0.135" />
        <stop offset="0.0254" stop-color="var(--hero-ground)" stop-opacity="0.262" />
        <stop offset="0.0339" stop-color="var(--hero-ground)" stop-opacity="0.425" />
        <stop offset="0.0424" stop-color="var(--hero-ground)" stop-opacity="0.588" />
        <stop offset="0.0508" stop-color="var(--hero-ground)" stop-opacity="0.715" />
        <stop offset="0.0593" stop-color="var(--hero-ground)" stop-opacity="0.793" />
        <stop offset="0.0678" stop-color="var(--hero-ground)" stop-opacity="0.831" />
        <stop offset="1" stop-color="var(--hero-ground)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="hero-sheen" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="currentColor" stop-opacity="0" />
        <stop offset="0.5" stop-color="currentColor" stop-opacity="0.06" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>

      <!-- Crest lines, stroked repeatedly below to build each glow. -->
      <path id="hero-crest-upper" d="M-200 40 C 300 -40, 700 120, 1050 160 C 1300 190, 1500 300, 1750 340 C 1950 370, 2100 330, 2400 250" fill="none" stroke="currentColor"></path>
      <path id="hero-crest-main" d="M-200 340 C 150 240, 350 260, 520 400 C 650 510, 780 600, 1000 610 C 1250 620, 1450 560, 1650 540 C 1850 520, 2050 600, 2400 720" fill="none" stroke="currentColor"></path>
      <path id="hero-crest-right" d="M1100 760 C 1400 690, 1700 560, 1900 460 C 2050 380, 2150 300, 2400 220" fill="none" stroke="currentColor"></path>
    </defs>

    <!-- upper dune -->
    <g class="w2">
      <path d="M-200 40 C 300 -40, 700 120, 1050 160 C 1300 190, 1500 300, 1750 340 C 1950 370, 2100 330, 2400 250 L 2400 -200 L -200 -200 Z" fill="url(#hero-ridge-soft)"></path>
      <use href="#hero-crest-upper" stroke-width="14.28" stroke-opacity="0.002"></use>
      <use href="#hero-crest-upper" stroke-width="12.94" stroke-opacity="0.002"></use>
      <use href="#hero-crest-upper" stroke-width="11.44" stroke-opacity="0.0041"></use>
      <use href="#hero-crest-upper" stroke-width="9.72" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="8.55" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="7.61" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="6.79" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="6.05" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="5.33" stroke-opacity="0.0059"></use>
      <use href="#hero-crest-upper" stroke-width="4.62" stroke-opacity="0.006"></use>
      <use href="#hero-crest-upper" stroke-width="3.9" stroke-opacity="0.006"></use>
      <use href="#hero-crest-upper" stroke-width="3.1" stroke-opacity="0.0061"></use>
      <use href="#hero-crest-upper" stroke-width="2.14" stroke-opacity="0.0073"></use>
    </g>

    <!-- main lower ridge -->
    <g class="w1">
      <path d="M-200 340 C 150 240, 350 260, 520 400 C 650 510, 780 600, 1000 610 C 1250 620, 1450 560, 1650 540 C 1850 520, 2050 600, 2400 720 L 2400 900 L -200 900 Z" fill="url(#hero-ridge)"></path>
      <use href="#hero-crest-main" stroke-width="14.47" stroke-opacity="0.0063"></use>
      <use href="#hero-crest-main" stroke-width="13.12" stroke-opacity="0.0063"></use>
      <use href="#hero-crest-main" stroke-width="11.6" stroke-opacity="0.0128"></use>
      <use href="#hero-crest-main" stroke-width="9.86" stroke-opacity="0.0186"></use>
      <use href="#hero-crest-main" stroke-width="8.67" stroke-opacity="0.0186"></use>
      <use href="#hero-crest-main" stroke-width="7.72" stroke-opacity="0.0188"></use>
      <use href="#hero-crest-main" stroke-width="6.9" stroke-opacity="0.0192"></use>
      <use href="#hero-crest-main" stroke-width="6.14" stroke-opacity="0.0195"></use>
      <use href="#hero-crest-main" stroke-width="5.41" stroke-opacity="0.0199"></use>
      <use href="#hero-crest-main" stroke-width="4.69" stroke-opacity="0.0203"></use>
      <use href="#hero-crest-main" stroke-width="3.95" stroke-opacity="0.0208"></use>
      <use href="#hero-crest-main" stroke-width="3.15" stroke-opacity="0.0215"></use>
      <use href="#hero-crest-main" stroke-width="2.18" stroke-opacity="0.026"></use>
      <use href="#hero-crest-main" stroke-width="1" stroke-opacity="0.9"></use>
      <path d="M-200 370 C 150 270, 350 290, 520 430 C 650 540, 780 630, 1000 640 C 1250 650, 1450 590, 1650 570 C 1850 550, 2050 630, 2400 750 L 2400 900 L -200 900 Z" fill="url(#hero-shadow)"></path>
    </g>

    <!-- right rising ridge -->
    <g class="w3">
      <path d="M1100 760 C 1400 690, 1700 560, 1900 460 C 2050 380, 2150 300, 2400 220 L 2400 900 L 1100 900 Z" fill="url(#hero-ridge-soft)"></path>
      <use href="#hero-crest-right" stroke-width="14.28" stroke-opacity="0.0037"></use>
      <use href="#hero-crest-right" stroke-width="12.94" stroke-opacity="0.0037"></use>
      <use href="#hero-crest-right" stroke-width="11.44" stroke-opacity="0.0075"></use>
      <use href="#hero-crest-right" stroke-width="9.72" stroke-opacity="0.0108"></use>
      <use href="#hero-crest-right" stroke-width="8.55" stroke-opacity="0.0108"></use>
      <use href="#hero-crest-right" stroke-width="7.61" stroke-opacity="0.0108"></use>
      <use href="#hero-crest-right" stroke-width="6.79" stroke-opacity="0.0109"></use>
      <use href="#hero-crest-right" stroke-width="6.05" stroke-opacity="0.011"></use>
      <use href="#hero-crest-right" stroke-width="5.33" stroke-opacity="0.0112"></use>
      <use href="#hero-crest-right" stroke-width="4.62" stroke-opacity="0.0113"></use>
      <use href="#hero-crest-right" stroke-width="3.9" stroke-opacity="0.0115"></use>
      <use href="#hero-crest-right" stroke-width="3.1" stroke-opacity="0.0117"></use>
      <use href="#hero-crest-right" stroke-width="2.14" stroke-opacity="0.014"></use>
      <use href="#hero-crest-right" stroke-width="0.8" stroke-opacity="0.7"></use>
    </g>

    <!-- travelling sheen -->
    <g class="sheen">
      <rect x="788" y="-100" width="600" height="914" fill="url(#hero-sheen)" transform="skewX(-25)"
      ></rect>
    </g>
  </svg>

  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>

    {
      primaryActions.length > 0 && (
        <div class="sl-flex actions">
          {primaryActions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
    {
      minimalActions.length > 0 && (
        <div class="sl-flex actions actions-minimal">
          {minimalActions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }

    {
      isLanding && (
        <div class="install" data-install>
          <div class="pm-tabs" role="tablist" aria-label="Package manager">
            {managers.map((pm, i) => (
              <button
                type="button"
                role="tab"
                class="pm-tab"
                data-pm={pm.id}
                data-command={pm.command}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {pm.label}
              </button>
            ))}
          </div>
          <div class="install-line">
            <code class="install-cmd" data-install-cmd translate="no">{managers[0]?.command}</code>
            <button
              type="button"
              class="copy-btn"
              data-copy-install
              aria-label="Copy install command"
            >
              <span class="copy-label">Copy</span>
            </button>
          </div>
        </div>
      )
    }

    {
      isLanding && (
        <button type="button" class="prompt-btn" data-copy-prompt data-prompt={agentPrompt}>
          <span class="copy-label">Copy a prompt for your AI agent</span>
        </button>
      )
    }
  </div>

  {
    isLanding && (
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
      </dl>
    )
  }
</section>

<script>
  const STORAGE_KEY = 'evs-pm';

  function flash(button: HTMLElement, text: string) {
    const label = button.querySelector<HTMLElement>('.copy-label');
    if (!label) return;
    const original = label.textContent;
    label.textContent = text;
    button.setAttribute('data-copied', '');
    window.setTimeout(() => {
      label.textContent = original;
      button.removeAttribute('data-copied');
    }, 1600);
  }

  async function copy(text: string, button: HTMLElement) {
    try {
      await navigator.clipboard.writeText(text);
      flash(button, 'Copied');
    } catch {
      flash(button, 'Press ⌘C');
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.pm-tab')];
    const cmd = root.querySelector<HTMLElement>('[data-install-cmd]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-install]');
    if (!cmd || !copyBtn) continue;

    const select = (tab: HTMLButtonElement, persist: boolean) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      }
      cmd.textContent = tab.dataset.command ?? '';
      if (persist) {
        try {
          localStorage.setItem(STORAGE_KEY, tab.dataset.pm ?? '');
        } catch {
          /* private mode etc. */
        }
      }
    };

    let stored: string | null = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    const initial = tabs.find((t) => t.dataset.pm === stored);
    if (initial) select(initial, false);

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab, true));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (dir === 0) return;
        e.preventDefault();
        const next = tabs[(tabs.indexOf(tab) + dir + tabs.length) % tabs.length];
        if (next) {
          select(next, true);
          next.focus();
        }
      });
    }

    copyBtn.addEventListener('click', () => void copy(cmd.textContent ?? '', copyBtn));
    cmd.addEventListener('click', () => void copy(cmd.textContent ?? '', copyBtn));
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
    btn.addEventListener('click', () => void copy(btn.dataset.prompt ?? '', btn));
  }
</script>

<style>
  .hero {
    /* Dark mode: the banner's own ground. Light mode: the site's paper tones. */
    --hero-ground: #040404;
    --hero-ground-top: #141414;
    --hero-ink: oklch(0.96 0 0);
    --hero-ink-soft: oklch(0.8 0 0);
    --hero-ink-mute: oklch(0.64 0 0);
    /* The ridges are a warm white; the accent token is the same sand at full strength. */
    --hero-ridge: oklch(0.92 0.022 65);
    --hero-border: oklch(1 0 0 / 0.1);
    --hero-chip: oklch(1 0 0 / 0.06);
    --hero-chip-on: oklch(1 0 0 / 0.14);
    --hero-field: color-mix(in oklch, var(--hero-ground) 90%, var(--hero-ink));

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    /* `minmax(0, …)`: the nowrap install command must not set the column's minimum width. */
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vmin, 3.5rem);
    margin-block: 0 1rem;
    padding: clamp(2.5rem, calc(1rem + 8vmin), 6rem) clamp(1.25rem, 4vw, 3.5rem)
      clamp(1.5rem, 3vmin, 2.5rem);
    border: 1px solid var(--hero-border);
    border-radius: var(--evs-radius-lg);
    background: linear-gradient(180deg, var(--hero-ground-top), var(--hero-ground));
    color: var(--hero-ink);
  }

  :global([data-theme='light']) .hero {
    --hero-ground: oklch(0.965 0 0);
    --hero-ground-top: oklch(1 0 0);
    --hero-ink: oklch(0.2 0 0);
    --hero-ink-soft: oklch(0.38 0 0);
    --hero-ink-mute: oklch(0.5 0 0);
    --hero-ridge: oklch(0.36 0.03 60);
    --hero-border: var(--evs-border);
    --hero-chip: oklch(0 0 0 / 0.05);
    --hero-chip-on: oklch(0 0 0 / 0.1);
    --hero-field: oklch(1 0 0);
  }

  .waves {
    position: absolute;
    inset: 0;
    /* Not a negative z-index: under `isolation: isolate` that puts the animated ridges in the
       same paint pass as the text above them, so every drift frame repaints the whole hero.
       The content is lifted instead (`.stack` / `.facts` below). */
    z-index: 0;
    width: 100%;
    height: 100%;
    color: var(--hero-ridge);
    pointer-events: none;
  }

  /* `will-change` asks for a compositing layer per ridge, so the drift is a transform of a
     cached raster rather than a re-paint. The ridges carry no filter for the same reason. */
  .waves .w1,
  .waves .w2,
  .waves .w3,
  .waves .sheen {
    will-change: transform;
  }

  .waves .w1 {
    animation: hero-drift1 14s ease-in-out infinite;
  }
  .waves .w2 {
    animation: hero-drift2 18s ease-in-out infinite;
  }
  .waves .w3 {
    animation: hero-drift3 16s ease-in-out infinite;
  }
  .waves .sheen {
    animation: hero-sheen 12s linear infinite;
  }
  .stack {
    animation: hero-fade-in 1.2s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .waves .w1,
    .waves .w2,
    .waves .w3,
    .waves .sheen,
    .stack {
      animation: none;
      will-change: auto;
    }
  }

  @keyframes hero-drift1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-40px, 14px);
    }
  }
  @keyframes hero-drift2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(36px, -12px);
    }
  }
  @keyframes hero-drift3 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-28px, -18px);
    }
  }
  @keyframes hero-sheen {
    from {
      transform: translateX(-1400px);
    }
    to {
      transform: translateX(1400px);
    }
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .stack,
  .facts {
    position: relative;
    z-index: 1;
  }

  .stack {
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .copy {
    flex-direction: column;
    gap: 1.125rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .copy > * {
    max-width: 56ch;
  }

  h1 {
    font-size: clamp(2.25rem, calc(0.75rem + 5vw), 4rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--hero-ink);
  }

  .tagline {
    font-size: clamp(1rem, calc(0.75rem + 0.8vw), 1.1875rem);
    line-height: 1.6;
    color: var(--hero-ink-soft);
    text-wrap: pretty;
  }

  .tagline :global(strong) {
    color: var(--hero-ink);
    font-weight: 550;
  }

  .tagline :global(code) {
    border: 1px solid var(--hero-border);
    border-radius: var(--evs-radius-sm);
    padding: 0.0625rem 0.3125rem;
    background: var(--hero-chip);
    color: var(--hero-ink);
    font-size: 0.875em;
    font-weight: 500;
  }

  .actions {
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .actions :global(.sl-link-button) {
    padding: 0.625rem 1.125rem;
    font-size: 0.9375rem;
  }

  /* Starlight sizes button icons at 1.5rem; next to 15px text that reads as a second label. */
  .actions :global(.sl-link-button svg) {
    font-size: 1.0625rem;
  }

  .actions-minimal {
    gap: 0.5rem 1.75rem;
    margin-top: -0.5rem;
  }

  .actions-minimal :global(.sl-link-button) {
    padding-inline: 0;
    color: var(--hero-ink-soft);
    font-weight: 450;
  }

  .actions-minimal :global(.sl-link-button:hover) {
