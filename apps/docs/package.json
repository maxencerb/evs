{
  "name": "@maxencerb/evs-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-playground.ts && astro build",
    "check:examples": "node scripts/check-playground-examples.ts",
    "check:snippets": "node scripts/check-snippets.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "node scripts/gen-playground.ts && astro dev",
    "gen:playground": "node scripts/gen-playground.ts",
    "preview": "astro preview",
    "typecheck": "node scripts/gen-playground.ts && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:docs",
    "@expressive-code/plugin-collapsible-sections": "catalog:docs",
    "astro": "catalog:docs",
    "monaco-editor": "catalog:docs",
    "starlight-links-validator": "catalog:docs",
    "starlight-llms-txt": "catalog:docs",
    "starlight-theme-rapide": "catalog:docs"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:docs",
    "@maxencerb/evs": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:docs"
  }
}
