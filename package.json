{
  "name": "evs-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^5.9.0",
      "viem": "2.52.2",
      "abitype": "^1.2.4"
    },
    "catalogs": {
      "testing": {
        "vitest": "^4.1.10",
        "prool": "^0.2.4",
        "@ethereumjs/evm": "^10.1.2"
      },
      "docs": {
        "astro": "^7.1.3",
        "@astrojs/starlight": "^0.41.3",
        "@astrojs/check": "^0.9.9",
        "starlight-theme-rapide": "^0.5.2",
        "starlight-links-validator": "^0.25.2",
        "starlight-llms-txt": "^0.11.0",
        "expressive-code-twoslash": "^0.6.1",
        "monaco-editor": "^0.56.0",
        "wrangler": "^4.100.0"
      }
    }
  },
  "scripts": {
    "build": "bun run --filter '@maxencerb/evs' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run --project unit --project types",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "lint:ci": "oxlint --deny-warnings --format github",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint:ci && bun run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "prool": "catalog:testing",
    "publint": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  },
  "overrides": {
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-frames": "^0.44.1",
    "@expressive-code/plugin-shiki": "^0.44.1",
    "@expressive-code/plugin-text-markers": "^0.44.1",
    "expressive-code": "^0.44.1"
  }
}
