{
  "name": "evs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run @maxencerb/evs#build",
    "typecheck": "vp run --filter '@maxencerb/*' typecheck",
    "test": "vp test run --project unit --project types",
    "test:integration": "vp test run --project integration",
    "test:all": "vp test run",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions",
    "lint:ci": "vp lint --deny-warnings --format github",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check && vp run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "prool": "catalog:testing",
    "publint": "^0.3.24",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:docs"
  },
  "packageManager": "pnpm@12.8.1"
}
