{
  "name": "evs-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "viem": "2.57.1",
      "abitype": "^1.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vite-plus": "1.0.0"
    },
    "catalogs": {
      "testing": {
        "vite-plus": "1.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
        "prool": "^0.2.16",
        "@ethereumjs/evm": "^10.1.3"
      },
      "docs": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/starlight": "^0.42.4",
        "@expressive-code/plugin-collapsible-sections": "^0.44.2",
        "astro": "^7.3.5",
        "monaco-editor": "^0.57.0",
        "satteri": "^0.10.5",
        "starlight-links-validator": "^0.26.0",
        "starlight-llms-txt": "^0.12.0",
        "starlight-theme-rapide": "^0.6.0",
        "wrangler": "^4.144.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@maxencerb/evs' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vp test run --project unit --project types",
    "test:integration": "vp test run --project integration",
    "test:all": "vp test run",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions",
    "lint:ci": "vp lint --deny-warnings --format github",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check && bun run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "prool": "catalog:testing",
    "publint": "^0.3.24",
    "typescript": "catalog:",
    "vite": "catalog:testing",
    "vite-plus": "catalog:testing",
    "wrangler": "catalog:docs"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
