{
  "name": "evs-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "viem": "2.56.5",
      "abitype": "^1.3.0"
    },
    "catalogs": {
      "testing": {
        "vite-plus": "0.3.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
        "prool": "^0.2.15",
        "@ethereumjs/evm": "^10.1.3"
      },
      "docs": {
        "astro": "^7.3.2",
        "@astrojs/starlight": "^0.42.0",
        "@astrojs/check": "^0.9.10",
        "starlight-theme-rapide": "^0.6.0",
        "starlight-links-validator": "^0.26.0",
        "starlight-llms-txt": "^0.11.0",
        "expressive-code-twoslash": "^0.6.1",
        "monaco-editor": "^0.56.0",
        "wrangler": "^4.131.2",
        "satteri": "^0.10.5"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@maxencerb/evs' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vp test run --project unit --project types",
    "test:integration": "vp test run --project integration",
    "test:all": "vp test run",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions",
    "lint:ci": "vp lint --deny-warnings --format github",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check && bun run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.4",
    "prool": "catalog:testing",
    "publint": "^0.3.24",
    "typescript": "catalog:",
    "vite": "catalog:testing",
    "vite-plus": "catalog:testing"
  },
  "overrides": {
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-frames": "^0.44.2",
    "@expressive-code/plugin-shiki": "^0.44.2",
    "@expressive-code/plugin-text-markers": "^0.44.2",
    "expressive-code": "^0.44.2",
    "vite": "catalog:testing",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
